{
  "debug": false,
  "address": "ws://example.com:8080",
  "authToken": "",
  "admin": 0,
  "updateUrl": "https://github.com/Magic-Xin/MacArthurGo/releases/download/Prerelease-dev/",
  "updateInterval": 86400,
  "bannedList": [],
  "plugins": {
    "corpus": {
      "enable": false,
      "rules": [
        {
          "regexp": "^a$",
          "reply": "reply all",
          "scene": "all",
          "users": [123456],
          "groups": [123456, 654321]
        },
        {
          "regexp": "^g$",
          "reply": "reply group",
          "scene": "group"
        },
        {
          "regexp": "^p$",
          "reply": "reply private",
          "isReply": true,
          "isAt": false,
          "scene": "private"
        }
      ]
    },
    "originPic": {
      "enable": false,
        "args": ["/origin", "/o", "/原图", "/原"]
    },
    "repeat": {
      "enable": false,
      "times": 3,
      "probability": 0.4,
      "commonProbability": 0.001
    },
    "bili": {
      "enable": false,
      "aiSummarize": {
        "enable": true,
        "groupForward": true
      }
    },
    "poke": {
      "enable": false,
      "args": ["/poke", "/p"]
    },
    "roll": {
      "enable": false,
      "args": ["/roll", "/r"]
    },
    "music": {
      "enable": false
    },
    "picSearch":{
      "enable": false,
      "args": ["/search", "/s"],
      "groupForward": true,
      "allowPrivate": true,
      "handleBannedHosts": true,
      "expirationTime": 86400,
      "intervalTime": 1800,
      "sauceNAOToken": "",
      "ascii2d": {
        "cloudflareBypassUrl": "http://127.0.0.1:8000",
        "flareSolverrUrl": "",
        "proxyUrl": "",
        "timeoutSeconds": 90
      },
      "googleLens": {
        "apiKey": "",
        "timeoutSeconds": 30
      }
    },
    "statics": {
      "enable": false,
      "chartArgsMap": {
        "today": "/今日发言",
        "yesterday": "/昨日发言"
      },
      "wordCloudArgsMap": {
        "today": "/今日词云",
        "yesterday": "/昨日词云"
      },
      "stopWords": ["的", "了", "么", "啊", "吗", "你们", "我们", "http", "https"],
      "retentionDays": 3,
      "dataDir": "data/statics",
      "chart": {
        "width": 900,
        "height": 520
      },
      "wordCloud": {
        "width": 900,
        "height": 520,
        "maxWords": 80,
        "fontFile": "./NotoSansSC-Regular.ttf"
      }
    },
    "chatAI": {
      "enable": false,
      "chatGPT": {
        "enable": true,
        "args": ["/chatgpt", "/c"],
        "model": "gpt-3.5-turbo-1106",
        "apiKey": ""
      },
      "qWen": {
        "enable": true,
        "args": ["/qwen", "/q"],
        "model": "qwen-max",
        "apiKey": ""
      },
      "gemini": {
        "enable": true,
        "argsMap": {
            "flash": "/gf",
            "pro": "/gp",
            "image": "/gi"
        },
        "apiKey": ""
      },
      "github": {
        "enable": true,
        "argsMap": {
            "4o": "/4o",
            "o1p": "/o1p",
            "o3m": "/o3m",
            "llama": "/ll",
            "phi4": "/p4",
            "r1": "/r1"
        },
        "token": ""
      },
      "groupForward": true,
      "panGu": true
    },
    "waifu": {
      "enable": false,
      "args": ["/waifu", "wife", "/w"]
    }
  }
}
